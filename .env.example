# =============================================================================
# FREE SETUP (recommended) — see README "Free setup"
# =============================================================================

# --- LLM clip analysis (pick ONE free key; order of preference in code) ---
# 1) Groq free tier  https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.1-8b-instant

# 2) Google Gemini free tier  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# 3–4) Paid optional fallbacks (only if you already have them)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Leave all LLM keys empty → offline heuristic (zero cost, works in CI)

# --- YouTube ---
# Transcripts: youtube-transcript-api (FREE, no key)

# Discover / search only — optional for --url mode.
# YouTube Data API v3 free quota ≈ 10,000 units/day (Google Cloud).
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Upload: free Google OAuth (personal Cloud project / free tier).
# Enable YouTube Data API v3 → OAuth client (Desktop) → save JSON here.
GOOGLE_CLIENT_SECRETS=client_secrets.json

# Your channel (optional metadata)
CHANNEL_ID=

# Niche / category for discover
NICHE=Education
CATEGORY=27

# Pipeline defaults
MAX_SHORTS=10
VISIBILITY=private
CAPTION_STYLE=bold_yellow
MIN_CLIP_SECONDS=15
MAX_CLIP_SECONDS=59

# Paths (optional)
# DOWNLOADS_DIR=./downloads
# OUTPUT_DIR=./output
# TOKENS_DIR=./tokens
