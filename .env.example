# YouTube Data API v3 key (discover / search) — Google Cloud Console
YOUTUBE_API_KEY=

# LLM for viral clip picking (pick ONE). Leave empty to use offline heuristic.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# OAuth desktop client secrets JSON path (upload)
GOOGLE_CLIENT_SECRETS=client_secrets.json

# Your channel (optional metadata)
CHANNEL_ID=

# Niche / category for discover
NICHE=Education
CATEGORY=27

# Pipeline defaults
MAX_SHORTS=10
VISIBILITY=private
CAPTION_STYLE=bold_yellow
MIN_CLIP_SECONDS=15
MAX_CLIP_SECONDS=59

# Paths (optional)
# DOWNLOADS_DIR=./downloads
# OUTPUT_DIR=./output
# TOKENS_DIR=./tokens
